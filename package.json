{
  "name": "studio",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "API Circle Studio - greenfield API workspace with Git-backed sync, local mock servers, and an MCP server for AI clients",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@apicircle/web",
    "build": "turbo build",
    "test": "pnpm -r test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @apicircle/e2e-web test:e2e",
    "test:e2e:desktop": "pnpm --filter @apicircle/e2e-desktop test:e2e",
    "test:e2e:live-github": "pnpm --filter @apicircle/e2e-web test:e2e:live-github",
    "test:e2e:install": "pnpm --filter @apicircle/e2e-web test:e2e:install",
    "test:e2e:smoke": "pnpm --filter @apicircle/e2e-web exec playwright test --grep @smoke",
    "test:e2e:visual": "pnpm --filter @apicircle/e2e-web exec playwright test --project=visual-baseline",
    "e2e:coverage": "python scripts/e2e_coverage_report.py",
    "e2e:coverage:strict": "python scripts/e2e_coverage_report.py --strict --json",
    "e2e:tc-maps": "python scripts/build_tc_maps.py",
    "ci:local": "node scripts/ci-local/run-ci.mjs",
    "check": "turbo check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo clean && rm -rf node_modules",
    "changeset": "changeset",
    "release": "changeset version && pnpm install --lockfile-only",
    "release:publish": "changeset publish",
    "release:binaries": "node scripts/release/buildBinaries.mjs",
    "release:installers": "node scripts/release/buildDesktopInstallers.mjs",
    "icons": "node scripts/render-icons.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.0.0",
    "husky": "^9.0.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.0",
    "png2icons": "^2.0.1",
    "prettier": "^3.9.5",
    "turbo": "^2.10.4",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "ip-address": "^10.1.1",
      "fast-uri": "^3.1.2"
    }
  }
}
