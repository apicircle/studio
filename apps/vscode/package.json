{
  "name": "@apicircle/vscode",
  "displayName": "APICircle Studio",
  "description": "Git-backed API workspace with mocks, plans, and MCP — natively in VS Code.",
  "version": "0.1.0",
  "publisher": "apicircle",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/apicircle/studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/apicircle/studio.git",
    "directory": "apps/vscode"
  },
  "author": {
    "name": "API Circle",
    "email": "apicircle365@gmail.com"
  },
  "engines": {
    "vscode": "^1.94.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "api",
    "rest",
    "openapi",
    "graphql",
    "mock",
    "mcp",
    "postman",
    "insomnia"
  ],
  "main": "./dist/extension.mjs",
  "activationEvents": [
    "onView:apicircle.editor",
    "onView:apicircle.snapshots",
    "onView:apicircle.mock",
    "onCommand:apicircle.createWorkspace",
    "onCommand:apicircle.captureSnapshot",
    "onCommand:apicircle.setSnapshotMaxBytes",
    "onCommand:apicircle.newMock",
    "onCommand:apicircle.unlockVault",
    "onCommand:apicircle.lockVault",
    "onCommand:apicircle.setupVaultPassphrase",
    "onCommand:apicircle.changeVaultPassphrase",
    "onCommand:apicircle.openVaultEntry",
    "onCommand:apicircle.showRunsChannel",
    "onCommand:apicircle.copyMcpConfig",
    "onCommand:apicircle.openMcpConfigFile",
    "onCommand:apicircle.openMcpConnectGuide",
    "onCommand:apicircle.revealMcpBinaryInfo",
    "onCommand:apicircle.installCopilotMcpConfig",
    "onCommand:apicircle.installMcpForClient",
    "onCommand:apicircle.installMcpForAllClients",
    "onCommand:apicircle.uninstallMcpForClient",
    "onCommand:apicircle.forgetVaultOnDevice",
    "onCommand:apicircle.openPlanAsNotebook",
    "onNotebook:apicircle-plan",
    "onCommand:apicircle.startEmbeddedMcp",
    "onCommand:apicircle.stopEmbeddedMcp",
    "onCommand:apicircle.restartEmbeddedMcp",
    "onCommand:apicircle.copyEmbeddedMcpUrl",
    "onCommand:apicircle.editMockEndpoint",
    "onView:apicircle.mcp",
    "workspaceContains:**/.apicircle/workspace.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apicircle",
          "title": "APICircle Studio",
          "icon": "media/icon-activitybar.svg"
        }
      ]
    },
    "views": {
      "apicircle": [
        {
          "id": "apicircle.editor",
          "name": "Editor",
          "icon": "media/icon-activitybar.svg"
        },
        {
          "id": "apicircle.environment",
          "name": "Environment"
        },
        {
          "id": "apicircle.execution",
          "name": "Execution"
        },
        {
          "id": "apicircle.mock",
          "name": "Mock"
        },
        {
          "id": "apicircle.history",
          "name": "History"
        },
        {
          "id": "apicircle.snapshots",
          "name": "Snapshots"
        },
        {
          "id": "apicircle.mcp",
          "name": "MCP"
        },
        {
          "id": "apicircle.marketplace",
          "name": "Marketplace",
          "when": "config.apicircle.enableMarketplace"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "apicircle.editor",
        "contents": "Welcome to APICircle Studio.\n\nAPICircle keeps your API workspace in a Git-friendly file at [.apicircle/workspace.json](command:apicircle.openWorkspaceFile), so you can edit it here, in the desktop app, or in the web app — all on the same repo.\n\n[Create New Workspace](command:apicircle.createWorkspace)\n[Open Folder…](command:workbench.action.files.openFolder)"
      },
      {
        "view": "apicircle.environment",
        "contents": "Environments hold variables (`{{base_url}}`, secrets, …) you reference from requests.\n\n[New Environment](command:apicircle.newEnvironment)\n[Set Active Environment](command:apicircle.setActiveEnvironment)\n[Set Priority Order…](command:apicircle.setEnvPriorityOrder)"
      },
      {
        "view": "apicircle.execution",
        "contents": "Execution plans chain requests with assertions to validate end-to-end flows.\n\n[New Plan](command:apicircle.newPlan)"
      },
      {
        "view": "apicircle.mock",
        "contents": "No mock servers yet.\n\nMock servers spin up local HTTP endpoints from OpenAPI / Postman / Insomnia specs (or a manual endpoint list). Start them with ▶ Start, stop with ■ Stop — they live until VS Code closes.\n\n[New Mock…](command:apicircle.newMock)"
      },
      {
        "view": "apicircle.history",
        "contents": "Recent request and plan runs land here as you ▶ Send / Run.\n\nNo runs yet — send a request from the Editor view to populate this list."
      },
      {
        "view": "apicircle.snapshots",
        "contents": "No snapshots yet.\n\nWorkspace snapshots are point-in-time copies of `synced` state. Use them to undo accidental deletes or revert before risky imports — the safety net for Git-tracked workspace changes.\n\n[Capture Snapshot…](command:apicircle.captureSnapshot)\n[Set Storage Cap…](command:apicircle.setSnapshotMaxBytes)"
      },
      {
        "view": "apicircle.mcp",
        "contents": "MCP integration exposes your workspace to Claude Desktop, Claude Code, Cursor, Continue, Cline, Zed, Windsurf, GitHub Copilot, and ChatGPT.\n\nOpen a folder with `.apicircle/workspace.json` to see per-AI-client config snippets you can paste into each client.\n\n[Open Connect Guide](command:apicircle.openMcpConnectGuide)"
      },
      {
        "view": "apicircle.marketplace",
        "contents": "Discover public APICircle workspaces from the community.\n\nThe marketplace listing ships in v1.0."
      }
    ],
    "languages": [
      {
        "id": "apicircle-request",
        "aliases": [
          "APICircle Request"
        ],
        "extensions": [
          ".req.yaml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "apicircle-response",
        "aliases": [
          "APICircle Response"
        ],
        "extensions": [
          ".run.yaml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "apicircle-environment",
        "aliases": [
          "APICircle Environment"
        ],
        "extensions": [
          ".env.yaml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "apicircle-plan",
        "aliases": [
          "APICircle Plan"
        ],
        "extensions": [
          ".plan.yaml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "apicircle-mock",
        "aliases": [
          "APICircle Mock"
        ],
        "extensions": [
          ".mock.yaml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": "*.req.yaml",
        "url": "./schemas/apicircle-request.schema.json"
      },
      {
        "fileMatch": "*.env.yaml",
        "url": "./schemas/apicircle-environment.schema.json"
      },
      {
        "fileMatch": "*.plan.yaml",
        "url": "./schemas/apicircle-plan.schema.json"
      },
      {
        "fileMatch": "*.run.yaml",
        "url": "./schemas/apicircle-response.schema.json"
      },
      {
        "fileMatch": "*.mock.yaml",
        "url": "./schemas/apicircle-mock.schema.json"
      }
    ],
    "keybindings": [
      {
        "command": "apicircle.cancelSend",
        "key": "escape",
        "when": "editorTextFocus && resourceScheme == 'apicircle'"
      },
      {
        "command": "apicircle.sendRequest",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && resourceScheme == 'apicircle' && resourceExtname == .yaml"
      },
      {
        "command": "apicircle.refresh",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "focusedView == apicircle.editor || focusedView == apicircle.environment || focusedView == apicircle.execution || focusedView == apicircle.history || focusedView == apicircle.snapshots || focusedView == apicircle.mock || focusedView == apicircle.mcp || focusedView == apicircle.marketplace"
      },
      {
        "command": "apicircle.newRequest",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "focusedView == apicircle.editor"
      },
      {
        "command": "apicircle.newEnvironment",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "focusedView == apicircle.environment"
      },
      {
        "command": "apicircle.newPlan",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "focusedView == apicircle.execution"
      },
      {
        "command": "apicircle.runPlan",
        "key": "f6",
        "when": "focusedView == apicircle.execution"
      },
      {
        "command": "apicircle.captureSnapshot",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "focusedView == apicircle.snapshots"
      },
      {
        "command": "apicircle.newMock",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "focusedView == apicircle.mock"
      },
      {
        "command": "apicircle.startMock",
        "key": "f6",
        "when": "focusedView == apicircle.mock"
      },
      {
        "command": "apicircle.stopMock",
        "key": "shift+f6",
        "when": "focusedView == apicircle.mock"
      },
      {
        "command": "apicircle.restartMock",
        "key": "ctrl+shift+f6",
        "mac": "cmd+shift+f6",
        "when": "focusedView == apicircle.mock"
      }
    ],
