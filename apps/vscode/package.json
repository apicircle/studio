          "when": "view == apicircle.mcp",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "apicircle.sendRequest",
          "when": "view == apicircle.editor && viewItem == request",
          "group": "1_actions@1"
        },
        {
          "command": "apicircle.duplicateRequest",
          "when": "view == apicircle.editor && viewItem == request",
          "group": "2_modify@1"
        },
        {
          "command": "apicircle.deleteRequest",
          "when": "view == apicircle.editor && viewItem == request",
          "group": "9_danger@1"
        },
        {
