{
  "name": "@apicircle/desktop",
  "version": "1.2.0",
  "private": true,
  "description": "Electron shell that hosts the API Circle Studio UI with native OS-keychain secret storage.",
  "homepage": "https://github.com/apicircle/studio",
  "author": {
    "name": "API Circle",
    "email": "apicircle365@gmail.com"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsup",
    "build:renderer": "pnpm --filter @apicircle/web build",
    "build": "pnpm build:renderer && pnpm build:main",
    "check": "tsc -p tsconfig.main.json --noEmit",
    "smoke": "node scripts/build-smoke.mjs",
    "test": "vitest run",
    "start": "electron dist/main/main.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@apicircle/core": "workspace:*",
    "@apicircle/desktop-shell": "workspace:*",
    "@apicircle/shared": "workspace:*",
    "@apicircle/ui-components": "workspace:*",
    "@apicircle/web": "workspace:*",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^20.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
