{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [".claude/**"],
  "ignoreBinaries": ["python"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "ignoreDependencies": ["png2icons"],
      "ignore": ["scripts/vscode-bundle-budget.d.mts"]
    },
    "apps/desktop": {
      "entry": ["src/main/main.ts", "src/main/preload.ts", "scripts/*.mjs"],
      "ignore": ["src/main/electron-updater.d.ts"]
    },
    "e2e/web": {
      "entry": ["**/*.spec.ts", "manual-residue.ts", "scripts/*.mjs"]
    },
    "e2e/desktop": {
      "entry": ["**/*.spec.ts"],
      "ignoreDependencies": ["@apicircle/cli", "electron", "tsx"]
    },
    "apps/vscode": {
      "ignore": ["test/mocks/vscode.ts"],
      "ignoreDependencies": ["@modelcontextprotocol/sdk", "@hono/node-server", "hono"]
    },
    "e2e/vscode": {
      "entry": [
        "src/runTest.ts",
        "src/runTestLocal.ts",
        "src/test/index.ts",
        "src/test/**/*.test.ts"
      ],
      "ignoreDependencies": ["vscode", "@apicircle/shared", "@types/glob"]
    }
  }
}
