{
  "name": "@apicircle/e2e-mock",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "description": "Localhost mock server for the Editor E2E suite. Echoes requests, issues auth challenges, and serves deterministic responses.",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@apicircle/core": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.12.18"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
