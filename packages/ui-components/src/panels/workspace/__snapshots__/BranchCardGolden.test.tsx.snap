exports[`working-branch card — golden DOM with no branch change sources > renders the unpushed-changes strip and preview exactly as before > unpushed changes preview 1`] = `"<div class="flex max-h-[92vh] w-full flex-col rounded-md border border-border-strong bg-card shadow-elevated focus:outline-none max-w-3xl" role="dialog" aria-modal="true" aria-label="Unpushed changes preview" tabindex="-1"><div class="shrink-0 border-b border-border-subtle px-4 py-3 text-sm font-medium text-text-primary">Unpushed changes preview</div><div class="flex min-h-0 flex-1 flex-col overflow-y-auto p-4"><div class="flex flex-col gap-3"><p class="text-[0.6875rem] text-text-dim">Diff against first push (no upstream). Push to save commits these changes to the working branch.</p><div class="flex gap-2 text-[0.6875rem]"><span class="rounded-sm border border-success/40 bg-success/10 px-2 py-0.5 text-success">+1 added</span><span class="rounded-sm border border-warning/40 bg-warning/10 px-2 py-0.5 text-warning">~0 modified</span><span class="rounded-sm border border-danger/40 bg-danger/10 px-2 py-0.5 text-danger">-0 removed</span></div><ul class="max-h-96 space-y-1 overflow-y-auto" aria-label="Unpushed changes"><li class="rounded-sm border border-border bg-surface"><button type="button" class="flex w-full items-center gap-2 px-2 py-1 text-left text-xs" aria-expanded="false" aria-label="Toggle added Staging"><span class="shrink-0 rounded-sm border px-1.5 py-0.5 text-[0.625rem] uppercase tracking-wider border-success/40 bg-success/5 text-success">added</span><span class="rounded-sm border border-border bg-card px-1.5 py-0.5 text-[0.625rem] text-text-dim">environment</span><code class="flex-1 truncate text-text-primary">Staging</code><code class="shrink-0 rounded-sm bg-card px-1 py-0.5 font-mono text-[0.625rem] text-text-faint" <ID>>Staging</code><span class="text-[0.625rem] text-text-dim">+</span></button></li></ul><div class="flex justify-end pt-1"><button type="button" class="inline-flex h-7 items-center rounded-sm border border-border bg-surface px-3 text-xs text-text-muted hover:border-border-strong hover:text-text-primary">Close</button></div></div></div></div>"`;
