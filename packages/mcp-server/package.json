{
  "name": "@apicircle/mcp-server",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "Model Context Protocol server exposing API Circle Studio's workspace as a tool catalog. Used by Claude Desktop, ChatGPT, Cursor, GitHub Copilot, and any other MCP-compatible AI client.",
  "keywords": [
    "apicircle",
    "api",
    "api-circle",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "llm",
    "agent",
    "tool-catalog",
    "claude",
    "claude-desktop",
    "chatgpt",
    "cursor",
    "copilot",
    "continue",
    "cline",
    "zed",
    "windsurf",
    "openapi",
    "postman",
    "api-tools"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apicircle/studio.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/apicircle/studio#readme",
  "bugs": "https://github.com/apicircle/studio/issues",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "apicircle-mcp": "./dist/bin/mcp-server.cjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./prompts": "./src/prompts/mcpPrompts.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./prompts": {
        "import": {
          "types": "./dist/prompts/mcpPrompts.d.ts",
          "default": "./dist/prompts/mcpPrompts.js"
        },
        "require": {
          "types": "./dist/prompts/mcpPrompts.d.cts",
          "default": "./dist/prompts/mcpPrompts.cjs"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@apicircle/core": "workspace:*",
    "@apicircle/mock-server-core": "workspace:*",
    "@apicircle/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@apicircle/git": "workspace:*",
    "@types/node": "^20.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
