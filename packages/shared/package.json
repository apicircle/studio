{
  "name": "@apicircle/shared",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "Shared types, ID generation, validators, and encryption helpers for API Circle Studio.",
  "keywords": [
    "apicircle",
    "api",
    "api-circle",
    "types",
    "typescript",
    "validators",
    "encryption",
    "aes-gcm",
    "webcrypto",
    "id-generation",
    "utilities",
    "shared"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apicircle/studio.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/apicircle/studio#readme",
  "bugs": "https://github.com/apicircle/studio/issues",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist node_modules"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
