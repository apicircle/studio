{
  "name": "@apicircle/core",
  "version": "1.3.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "Request execution, environment resolution, auth signing, assertions, spec imports, and the applyMutation workspace engine for API Circle Studio.",
  "keywords": [
    "apicircle",
    "api",
    "api-circle",
    "api-client",
    "http-client",
    "rest",
    "graphql",
    "request",
    "openapi",
    "swagger",
    "postman",
    "insomnia",
    "har",
    "auth",
    "oauth2",
    "oidc",
    "jwt",
    "aws-sigv4",
    "ntlm",
    "hawk",
    "digest-auth",
    "assertions",
    "workspace",
    "git-backed"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apicircle/studio.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/apicircle/studio#readme",
  "bugs": "https://github.com/apicircle/studio/issues",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./workspace/file-backed": "./src/workspace/fileBackedWorkspace.ts",
    "./workspace/registry": "./src/workspace/workspaceRegistry.ts",
    "./test/mock-idp": "./src/auth/oauth2/__fixtures__/mockIdp.ts",
    "./providers": "./src/providers/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./workspace/file-backed": {
        "import": {
          "types": "./dist/workspace/file-backed.d.ts",
          "default": "./dist/workspace/file-backed.js"
        },
        "require": {
          "types": "./dist/workspace/file-backed.d.cts",
          "default": "./dist/workspace/file-backed.cjs"
        }
      },
      "./workspace/registry": {
        "import": {
          "types": "./dist/workspace/registry.d.ts",
          "default": "./dist/workspace/registry.js"
        },
        "require": {
          "types": "./dist/workspace/registry.d.cts",
          "default": "./dist/workspace/registry.cjs"
        }
      },
      "./test/mock-idp": {
        "import": {
          "types": "./dist/test/mock-idp.d.ts",
          "default": "./dist/test/mock-idp.js"
        },
        "require": {
          "types": "./dist/test/mock-idp.d.cts",
          "default": "./dist/test/mock-idp.cjs"
        }
      },
      "./providers": {
        "import": {
          "types": "./dist/providers.d.ts",
          "default": "./dist/providers.js"
        },
        "require": {
          "types": "./dist/providers.d.cts",
          "default": "./dist/providers.cjs"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@apicircle/mock-server-core": "workspace:*",
    "@apicircle/shared": "workspace:*",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4",
    "tsup": "^8.3.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
