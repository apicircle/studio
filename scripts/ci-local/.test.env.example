# ─────────────────────────────────────────────────────────────────────────────
# API Circle Studio — local CI runner environment
#
# Copy this file to ".test.env" (same folder) and fill in values:
#     cp scripts/ci-local/.test.env.example scripts/ci-local/.test.env
#
# ".test.env" and ".secrets.env" are git-ignored — never commit real tokens.
# You can keep tokens in a separate ".secrets.env" (auto-loaded) if you prefer
# to keep them out of ".test.env".
# ─────────────────────────────────────────────────────────────────────────────

# Host platform you are running on. One of: windows | mac | ubuntu
# Controls platform-dependent behavior — on Linux the desktop (Electron) and
# VS Code cross-host E2E suites are wrapped in `xvfb-run`; on Windows/Mac they
# run natively. If omitted, the platform is auto-detected from the OS.
CI_PLATFORM=windows

# ── Pipeline toggles (1 = on, 0 = off) ───────────────────────────────────────
# Heavy / destructive / external-network suites are OFF by default. The default
# run (no toggles) is: setup + ci + vscode + e2e.

# Live-GitHub E2E. ⚠️ DESTRUCTIVE: creates and DELETES real repositories under
# the bot account below. Requires the three APICIRCLE_E2E_* values further down.
RUN_LIVE_GITHUB=0

# CodeQL static analysis. Requires the CodeQL CLI on PATH (`codeql`).
# Install: https://github.com/github/codeql-cli-binaries
RUN_CODEQL=0

# VS Code cross-host E2E smoke (stable + insiders). Downloads a full VS Code
# build (~100 MB) on first run.
RUN_VSCODE_E2E=0

# Desktop (Electron) E2E suite. ON by default — runs natively on your OS.
RUN_DESKTOP_E2E=1

# Cross-browser (Firefox + WebKit) @smoke E2E. ON by default.
RUN_CROSS_BROWSER=1

# Visual-baseline screenshots. OFF by default (Linux baselines are not committed,
# so this only makes sense on a machine whose snapshots you intend to author).
RUN_VISUAL=0

# Conventional-commit lint of HEAD vs origin/main. OFF by default (PR-only in CI).
RUN_COMMITLINT=0

# Treat the E2E coverage gate (--fail-under=20) as a hard failure. Default: warn.
STRICT_COVERAGE=0

# ── Live-GitHub credentials (only needed when RUN_LIVE_GITHUB=1) ──────────────
# Operator runbook: docs/qa/live-github-bot-setup.md
# Tip: put these in ".secrets.env" instead of here to keep tokens separate.

# Master switch the live-GitHub specs themselves check (keep =1 when running them).
APICIRCLE_E2E_LIVE_GITHUB=1

# Bot account / org login that OWNS the ephemeral repos, e.g. apicirclebot.
# Use a throwaway bot account — repos here are created and deleted automatically.
APICIRCLE_E2E_BOT_OWNER=

# Classic PAT for the bot, scopes: repo + delete_repo
APICIRCLE_E2E_GITHUB_PAT=

# Second classic PAT for the bot, scopes: repo (dedicated-token link tests)
APICIRCLE_E2E_BOT_PAT_LINK_DEDICATED=

# Set to 1 to KEEP created repos for debugging instead of deleting them.
APICIRCLE_E2E_KEEP_REPOS=0
