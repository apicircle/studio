# QA run artifacts — coverage reports + manual-run workbooks/evidence.
# Auto-generated by scripts/e2e_coverage_report.py and the Cowork runner;
# CI publishes them as build artifacts, so they are not committed.
docs/qa/results/

# Vite/Vitest temp files (created during dev server, break ESLint if cached)
*.timestamp-*.mjs

# Tool caches
.eslintcache
__pycache__/
*.pyc

# Per-device MCP runtime state — written by the MCP server when pointed at a
